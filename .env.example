# API variables: export in your shell before starting the server.
PORT=3001
DATABASE_PATH=server/data/lostchain.sqlite
APP_ORIGIN=http://127.0.0.1:5173
STAFF_EMAILS=
# NODE_ENV=production enables Secure session cookies (requires HTTPS).

# Optional local blockchain metadata service (export before startup)
CHAIN_DATABASE_PATH=server/data/chain.sqlite
CHAIN_API_PORT=3002
# For metadata:dev, APP_ORIGIN must match http://127.0.0.1:5174
